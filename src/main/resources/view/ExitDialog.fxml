<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<StackPane xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1">
   <children>
      <VBox alignment="CENTER" spacing="15.0">
         <children>
            <StackPane fx:id="warningSignContainer" prefHeight="80.0" />
            <Label styleClass="top-label" stylesheets="@exit-dialog.css" text="Do you want to exit?" />
            <Label styleClass="bottom-label" stylesheets="@exit-dialog.css" text="All unsaved progress&#10;would be lost!&#10;" textAlignment="CENTER" />
            <HBox alignment="CENTER" spacing="20.0">
               <children>
                  <Button fx:id="yesButton" focusTraversable="false" mnemonicParsing="false" onAction="#yesButtonHandler" styleClass="yes-button" stylesheets="@exit-dialog.css" text="Yes" />
                  <Button fx:id="noButton" focusTraversable="false" mnemonicParsing="false" onAction="#noButtonHandler" styleClass="no-button" stylesheets="@exit-dialog.css" text="No" />
               </children>
               <padding>
                  <Insets bottom="13.0" left="10.0" right="10.0" top="17.0" />
               </padding>
            </HBox>
         </children>
      </VBox>
      <Button focusTraversable="false" mnemonicParsing="false" onAction="#xButtonHandler" styleClass="x-button" stylesheets="@exit-dialog.css" text="✕" translateX="161.0" translateY="-148.0" fx:id="xButton" />
   </children>
</StackPane>
